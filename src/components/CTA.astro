---
import Eyebrow from './Eyebrow.astro';
import Isotipo from './Isotipo.astro';
const email = 'hola@ifmeralabai.com';
---
<section id="contacto" class="cta-sec">
  <div class="wrap">
    <div class="cta-brand"><Isotipo size={52} /></div>
    <Eyebrow label="Hablemos" />
    <h2>¿Listo para transformar tu portal digital?</h2>
    <p>Cuéntanos tu proyecto. Diseñamos la solución a la medida de tu redacción, tu empresa o tu idea.</p>
    <div class="hero-actions">
      <a href={`mailto:${email}`} class="btn btn-primary">Agendar conversación</a>
    </div>
    <a class="mail" href={`mailto:${email}`}>{email}</a>
  </div>
</section>
